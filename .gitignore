# =========================
# Python
# =========================

__pycache__/
.pytest_cache/
*.py[cod]
*$py.class

# Virtual environments

.venv/
venv/
env/

# Python packaging

*.egg-info/
dist/
build/

# =========================
# Jupyter
# =========================

.ipynb_checkpoints/

# =========================
# Environment files
# =========================

.env
.env.*

# =========================
# Data
# =========================

# Raw datasets
data/raw/*
!data/raw/.gitkeep

# Processed datasets
data/processed/*
!data/processed/.gitkeep

# =========================
# Machine Learning Outputs
# =========================

models/*
!models/.gitkeep

results/*
!results/.gitkeep

# figures/ is tracked so the README can embed the plots

# =========================
# OS
# =========================

.DS_Store
.AppleDouble
.LSOverride

# =========================
# IDE
# =========================

.vscode/*
!.vscode/extensions.json

.idea/

# =========================
# Logs
# =========================

*.log

# =========================
# Downloaded / raw data anywhere in the repo
# =========================

# scanpy's default download and cache folders (relative to the notebook's cwd)
notebooks/data/
notebooks/cache/
cache/

# Single-cell data files should only live under data/, which is ignored above
*.h5ad
*.h5
*.loom
*.mtx
*.mtx.gz
*.tar.gz
